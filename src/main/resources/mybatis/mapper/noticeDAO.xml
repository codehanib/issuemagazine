<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.issuemagazine.dao.noticeDAO">
	<select id="noticeList" resultType="com.springboot.issuemagazine.dto.noticeDTO">
		select * from notice order by n_no desc
	</select>
	<select id="noticeView" resultType="com.springboot.issuemagazine.dto.noticeDTO">
		select * from notice where n_no=#{n_no}
	</select>
	<insert id="noticeWrite">
		insert into notice(n_no,n_title,n_content,n_reg_date,n_count,m_no)
		 values(notice_seq.nextval,#{n_title},#{n_content},SYSDATE,0,#{m_no})
	</insert>
	<update id="noticeUpdate">
		update notice set n_title=#{n_title},n_content=#{n_content},n_reg_date=SYSDATE
			where n_no=#{n_no}
	</update>
	<update id="noticeCountUp">
    update notice set n_count = n_count + 1 where n_no = #{n_no}
	</update>
	<delete id="noticeDelete">
		delete from notice where n_no=#{n_no}
	</delete>
</mapper>
