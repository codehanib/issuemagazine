<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.issuemagazine.dao.noticeDAO">

	<!-- 공지 상세보기 -->
	<select id="noticeView" resultType="com.springboot.issuemagazine.dto.noticeDTO">
		select * from notice where n_no=#{n_no}
	</select>
	
	<!-- 공지 작성 -->
	<insert id="noticeWrite">
		insert into notice(n_no,n_title,n_content,n_reg_date,n_count,m_no)
		 values(notice_seq.nextval,#{n_title},#{n_content},SYSDATE,0,#{m_no})
	</insert>
	
	<!-- 공지 수정 -->
	<update id="noticeUpdate">
		update notice set n_title=#{n_title},n_content=#{n_content},n_reg_date=SYSDATE
			where n_no=#{n_no}
	</update>
	
	<!-- 공지 조회수 증가 -->
	<update id="noticeCountUp">
		update notice set n_count = n_count + 1 where n_no = #{n_no}
	</update>
	
	<!-- 공지 삭제 -->
	<delete id="noticeDelete">
		delete from notice where n_no=#{n_no}
	</delete>
	
	<!-- 다음글 -->
	<select id="noticeNext" resultType="com.springboot.issuemagazine.dto.noticeDTO">
		select * from notice
		where n_no &lt; #{n_no}
		order by n_no desc
		fetch first 1 rows only
	</select>
	
	<!-- 이전글 -->
	<select id="noticePrev" resultType="com.springboot.issuemagazine.dto.noticeDTO">
		select * from notice
		where n_no > #{n_no}
		order by n_no asc
		fetch first 1 rows only
	</select>
 
	<!-- 검색 조건에 맞는 전체 게시글 수 조회 -->
	<select id="noticeSearchCount" resultType="int">
		select count(*) from notice
		<where>
			<if test="keyword != null and keyword != ''">
				<choose>
					<when test="searchType == 'title'">
						and n_title like '%' || #{keyword} || '%'
					</when>
					<when test="searchType == 'content'">
						and n_content like '%' || #{keyword} || '%'
					</when>
					<otherwise>
						and (n_title like '%' || #{keyword} || '%'
							or n_content like '%' || #{keyword} || '%')
					</otherwise>
				</choose>
			</if>
		</where>
	</select>

	<!-- 페이징 10개 처리 및 검색 목록 조회 -->
	<select id="noticeSearch" resultType="com.springboot.issuemagazine.dto.noticeDTO">
		select * from notice
		<where>
			<if test="keyword != null and keyword != ''">
				<choose>
					<when test="searchType == 'title'">
						and n_title like '%' || #{keyword} || '%'
					</when>
					<when test="searchType == 'content'">
						and n_content like '%' || #{keyword} || '%'
					</when>
					<otherwise>
						and (n_title like '%' || #{keyword} || '%'
							or n_content like '%' || #{keyword} || '%')
					</otherwise>
				</choose>
			</if>
		</where>
		order by n_no desc
		offset #{offset} rows fetch next #{recordPerPage} rows only
	</select>

</mapper>