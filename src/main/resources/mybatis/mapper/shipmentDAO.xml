<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper 
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.springboot.issuemagazine.dao.IshipmentDAO">

    <!-- 회원: 자신의 배송 목록 조회 -->
    <select id="shipmentMemberList" resultType="com.springboot.issuemagazine.dto.shipmentDTO">
		SELECT s_d_no, s_delivery, s_status
        	FROM shipment
        	WHERE m_no = #{m_no}
        	ORDER BY s_no DESC
    </select>

</mapper>