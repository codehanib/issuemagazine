<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper 
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.issuemagazine.dao.memberDAO">

	<select id="findById" resultType="com.springboot.issuemagazine.dto.memberDTO">
	    select * from member where m_id = #{m_id}
	</select>
	<insert id="memberInsert">
		insert into member(m_no, m_id, m_passwd, m_name, m_zipno, m_addr, m_tel, m_email,m_auth)
        	values(member_seq.nextval,
				            #{m_id},
				            #{m_passwd},
				            #{m_name},
				            #{m_zipno},
				            #{m_addr},
				            #{m_tel},
				            #{m_email},
				            'USER'
			 		  )
	</insert>
	<delete id="memberDelete">
		delete from member where m_id = #{m_id}
	</delete>
		<update id="memberUpdate">
		update member set m_passwd=#{m_passwd},m_zipno=#{m_zipno},m_addr=#{m_addr},m_tel=#{m_tel},m_email=#{m_email}
			where m_id=#{m_id}
	</update>
</mapper>