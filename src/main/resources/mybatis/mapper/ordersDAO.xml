<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper 
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.issuemagazine.dao.IordersDAO">
	<insert id="ordersInsert">
		insert into orders(o_no,m_no)
		 values(orders_seq.NEXTVAL,#{m_no})
	</insert>
	<insert id="orders_detailInsert">
		insert into orders_detail(od_no,od_name,od_quantity,od_sub_date,od_price,o_no,p_no)
		 values(orders_detail_seq.NEXTVAL,#{od_name},#{od_quantity},#{od_sub_date},#{od_price},#{o_no},#{p_no})
	</insert>
	<select id="ordersList" resultType="com.springboot.issuemagazine.dto.ordersDTO">
		select * from orders by o_no desc
	</select>
	<select id="orders_detailList" resultType="com.springboot.issuemagazine.dto.orders_detailDTO">
		select * from orders_detail where o_no=#{o_no}
	</select>
	<delete id="ordersDelete">
		delete from orders where o_no=#{o_no}
	</delete>
</mapper>